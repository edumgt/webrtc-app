# ---- Hermes LLM 엔드포인트 ----
# provider: ollama | openai  (openai = OpenAI 호환 API: vLLM, LM Studio, OpenRouter 등)
HERMES_LLM_PROVIDER=ollama
HERMES_MODEL=hermes3:8b
# 비우면 OLLAMA_HOST(예: 172.29.32.1:11434)를 따르고, 그것도 없으면 localhost:11434
HERMES_BASE_URL=
HERMES_API_KEY=NA
HERMES_TEMPERATURE=0.2

# ---- 파이프라인 ----
# QA FAIL 시 Developer 재작업 최대 횟수
HERMES_MAX_ITERATIONS=2
# 셸 도구 명령 타임아웃(초)
HERMES_SHELL_TIMEOUT=600

# ---- CrewAI 텔레메트리 비활성화 ----
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
